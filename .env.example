# Server Configuration
PORT=5000
NODE_ENV=development

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Loom Designs & Digitals <noreply@loomdigitalsdesigns.com>

# Application URLs
CLIENT_URL=http://localhost:3000
ADMIN_EMAIL=admin@loomdigitalsdesigns.com

# CORS Configuration (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# Session Secret (generate a strong secret in production)
SESSION_SECRET=your-session-secret-key

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000 # 15 minutes
RATE_LIMIT_MAX=100 # 100 requests per window
